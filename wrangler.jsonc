{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lp-auxilio-noemia",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./"
  },
  // Domínio próprio (zona noemiaingracio.adv.br na Cloudflare). Endereços *.workers.dev desativados.
  "routes": [
    { "pattern": "lp-auxilio.noemiaingracio.adv.br", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
